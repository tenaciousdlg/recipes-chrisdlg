---
import { load as parseYaml } from 'js-yaml';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPrimaryIngredient, formatMeasure } from '../../lib/scale';
import { isHighProtein } from '../../lib/macros';
import { splitTimers } from '../../lib/timers';
import { stepIngredients } from '../../lib/cook';
// ?raw has Vite inline the file's text at build time; node:fs isn't available
// in the Cloudflare-adapter's Workers-emulated prerender step.
import ingredientsYamlRaw from '../../data/ingredients.yaml?raw';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const primary = getPrimaryIngredient(recipe.data.ingredients);

// count_noun from the ingredient DB names the sub-unit a count of that item means
// (garlic -> cloves, cilantro -> sprigs), so quantities read unambiguously
const ingredientsDb = parseYaml(ingredientsYamlRaw) as Record<string, { count_noun?: string }>;
const countNoun = (item: string) => ingredientsDb[item]?.count_noun ?? null;

// groups ingredients by recipe sub-component (sauce, pickle, etc); undefined = main dish, shown first
const groups: Array<{ name: string | undefined; items: typeof recipe.data.ingredients }> = [];
for (const ing of recipe.data.ingredients) {
  let group = groups.find((g) => g.name === ing.group);
  if (!group) {
    group = { name: ing.group, items: [] };
    groups.push(group);
  }
  group.items.push(ing);
}
groups.sort((a, b) => (a.name === undefined ? -1 : b.name === undefined ? 1 : 0));

// per step, the ingredients it mentions: shown under the step in Cooking Mode's step view
const stepIngs = recipe.data.steps.map((step) => stepIngredients(step, recipe.data.ingredients));
---

<Layout title={recipe.data.title} description={recipe.data.description}>
  <a href="/" class="cook-hide">&larr; all recipes</a>
  <h1>
    {recipe.data.title}
    <span class="tag category-tag cook-hide">{recipe.data.category}</span>
  </h1>
  <p class="cook-hide">{recipe.data.description}</p>
  <div class="tags cook-hide">
    {isHighProtein(recipe.data.macros_per_serving) && <span class="tag">high-protein</span>}
    {recipe.data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
  </div>

  <div class="cooking-mode-control">
    <button id="cooking-mode-toggle" type="button" aria-pressed="false">Cooking Mode</button>
    <span id="cooking-mode-status" class="recipe-meta"></span>
  </div>

  <!-- Cooking Mode only: timers running on other steps, and step navigation -->
  <div id="timer-tray" class="cook-only" aria-live="polite"></div>
  <div class="cook-only cook-progress"><div id="cook-progress-bar"></div></div>
  <p id="cook-page-label" class="cook-only"></p>

  <div class="box cook-hide">
    <div class="scale-control">
      <label for="scale-input">Scale by {primary.item} ({primary.unit}):</label>
      <input
        id="scale-input"
        type="number"
        step="any"
        min="0"
        value={primary.qty}
        data-base-qty={primary.qty}
        data-base-servings={recipe.data.base_servings}
      />
      <span>&rarr; <span id="servings-out" class="servings-out">{recipe.data.base_servings}</span> servings</span>
    </div>
    <div id="scale-note" class="note-banner">
      Cooking times don't scale linearly with quantity: use the times in the steps below as a guide, not an exact multiple.
    </div>
  </div>

  <section id="cook-ingredients">
    <p class="cook-only recipe-meta">
      for <span id="cook-servings">{recipe.data.base_servings}</span> servings · change the scale outside Cooking Mode
    </p>
    {groups.map((group) => (
      <div class="ingredient-group">
        {group.name && <h3>{group.name}</h3>}
        <ul class="ingredient-list">
          {group.items.map((ing) => (
            <li data-ingredient data-qty={ing.qty} data-scale={ing.scale ? '1' : '0'} data-unit={ing.unit} data-count-noun={countNoun(ing.item)}>
              <span class="qty">{formatMeasure(ing.qty, ing.unit, countNoun(ing.item))}</span>
              <span>
                {ing.prep ? `${ing.item}, ${ing.prep}` : ing.item}
                {!ing.scale ? <span class="fixed-note"> (fixed)</span> : null}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <h2 class="cook-hide">Steps</h2>
  <ol id="steps">
    {recipe.data.steps.map((step, i) => (
      <li><p class="step-text">{splitTimers(step).map((part, j) =>
        typeof part === 'string' ? part : (
          <button
            type="button"
            class="step-timer"
            data-timer-id={`${i}-${j}`}
            data-seconds={part.seconds}
            data-label={part.text}
            aria-label={`start ${part.text} timer`}
          >{part.text}</button>
        ),
      )}</p>{stepIngs[i].length > 0 && (
        <ul class="ingredient-list step-ingredients">
          {stepIngs[i].map((ing) => (
            <li data-ingredient data-qty={ing.qty} data-scale={ing.scale ? '1' : '0'} data-unit={ing.unit} data-count-noun={countNoun(ing.item)}>
              <span class="qty">{formatMeasure(ing.qty, ing.unit, countNoun(ing.item))}</span>
              <span>{ing.item}</span>
            </li>
          ))}
        </ul>
      )}</li>
    ))}
  </ol>

  <nav id="cook-nav" class="cook-only" aria-label="recipe steps">
    <button id="cook-prev" type="button">&larr; Back</button>
    <button id="cook-next" type="button">Next &rarr;</button>
  </nav>

  {recipe.data.macros_per_serving && (
    <div class="cook-hide">
      <h2>Macros (per serving)</h2>
      <div class="box macros">
        <div><div class="val">{recipe.data.macros_per_serving.calories}</div><div class="label">cal</div></div>
        <div><div class="val">{recipe.data.macros_per_serving.protein_g}g</div><div class="label">protein</div></div>
        <div><div class="val">{recipe.data.macros_per_serving.carbs_g}g</div><div class="label">carbs</div></div>
        <div><div class="val">{recipe.data.macros_per_serving.fat_g}g</div><div class="label">fat</div></div>
      </div>
      <p class="recipe-meta">
        {recipe.data.macros_per_serving.source === 'manual' ? 'hand-entered' : 'computed'} · per serving, does not rescale with batch size
      </p>
    </div>
  )}

  {recipe.data.notes && (
    <div class="cook-hide">
      <h2>Notes</h2>
      <p>{recipe.data.notes}</p>
    </div>
  )}

  <div class="cook-hide"><Content /></div>
</Layout>

<script>
  import { scaleFactor, scaledServings, formatQty, formatMeasure } from '../../lib/scale';

  const input = document.getElementById('scale-input') as HTMLInputElement;
  const servingsOut = document.getElementById('servings-out')!;
  const note = document.getElementById('scale-note')!;
  const rows = document.querySelectorAll<HTMLLIElement>('[data-ingredient]');

  function update() {
    const target = parseFloat(input.value);
    if (Number.isNaN(target) || target < 0) return;

    const baseQty = parseFloat(input.dataset.baseQty!);
    const baseServings = parseFloat(input.dataset.baseServings!);
    const factor = scaleFactor(baseQty, target);

    rows.forEach((row) => {
      const qtyEl = row.querySelector('.qty')!;
      const baseIngQty = parseFloat(row.dataset.qty!);
      const doesScale = row.dataset.scale === '1';
      const newQty = doesScale ? baseIngQty * factor : baseIngQty;
      qtyEl.textContent = formatMeasure(newQty, row.dataset.unit!, row.dataset.countNoun);
    });

    servingsOut.textContent = formatQty(scaledServings(baseServings, factor));
    document.getElementById('cook-servings')!.textContent = servingsOut.textContent;
    note.classList.toggle('visible', Math.abs(factor - 1) > 0.001);
  }

  input.addEventListener('input', update);
</script>

<script>
  // Cooking Mode: a step-by-step view (ingredients first, then one step per screen in big
  // text with Back/Next, swipe, and arrow keys) and, where supported, a screen wake lock
  // so you're not re-unlocking your phone with wet hands.
  const STORAGE_KEY = 'recipes-chrisdlg:cooking-mode';
  const PAGE_KEY = `recipes-chrisdlg:cook-page:${location.pathname}`;
  const button = document.getElementById('cooking-mode-toggle')!;
  const status = document.getElementById('cooking-mode-status')!;
  const supportsWakeLock = 'wakeLock' in navigator;

  // page 0 is the ingredient list, pages 1..n are the steps
  const steps = [...document.querySelectorAll<HTMLLIElement>('#steps > li')];
  const lastPage = steps.length;
  const prev = document.getElementById('cook-prev') as HTMLButtonElement;
  const next = document.getElementById('cook-next') as HTMLButtonElement;
  const label = document.getElementById('cook-page-label')!;
  const bar = document.getElementById('cook-progress-bar')!;
  let page = Math.min(Math.max(Number(localStorage.getItem(PAGE_KEY)) || 0, 0), lastPage);

  const cooking = () => document.body.classList.contains('cooking-mode');

  function show(target: number) {
    page = Math.min(Math.max(target, 0), lastPage);
    document.body.dataset.cookPage = String(page);
    steps.forEach((li, i) => li.classList.toggle('current', i === page - 1));
    label.textContent = page === 0 ? 'Ingredients' : `Step ${page} of ${lastPage}`;
    bar.style.width = `${(page / lastPage) * 100}%`;
    prev.disabled = page === 0;
    next.textContent = page === 0 ? 'Start cooking →' : page === lastPage ? 'Done ✓' : 'Next →';
    localStorage.setItem(PAGE_KEY, String(page));
    scrollTo(0, 0);
  }

  prev.addEventListener('click', () => show(page - 1));
  next.addEventListener('click', () => {
    if (page < lastPage) return show(page + 1);
    // finished: next time starts from the ingredients again
    page = 0;
    localStorage.setItem(PAGE_KEY, '0');
    disable();
  });

  document.addEventListener('keydown', (event) => {
    if (!cooking() || (event.target as HTMLElement).tagName === 'INPUT') return;
    if (event.key === 'ArrowRight') show(page + 1);
    if (event.key === 'ArrowLeft') show(page - 1);
  });

  // a horizontal swipe turns the page; mostly-vertical movement is scrolling, not a swipe
  let touchX = 0;
  let touchY = 0;
  document.addEventListener('touchstart', (event) => {
    touchX = event.changedTouches[0].clientX;
    touchY = event.changedTouches[0].clientY;
  }, { passive: true });
  document.addEventListener('touchend', (event) => {
    if (!cooking()) return;
    const dx = event.changedTouches[0].clientX - touchX;
    const dy = event.changedTouches[0].clientY - touchY;
    if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
    show(dx < 0 ? page + 1 : page - 1);
  });

  // the timer tray jumps to the step a timer belongs to
  document.addEventListener('cook:goto', (event) => {
    if (cooking()) show((event as CustomEvent<number>).detail);
  });

  let wakeLock: WakeLockSentinel | null = null;

  async function requestWakeLock() {
    if (!supportsWakeLock) return;
    try {
      wakeLock = await navigator.wakeLock.request('screen');
      wakeLock.addEventListener('release', () => {
        wakeLock = null;
      });
    } catch {
      // permission denied or transient failure; cooking mode still works, just without the wake lock
    }
  }

  function setStatus() {
    if (!supportsWakeLock) {
      status.textContent = "bigger text (this browser can't keep the screen awake)";
    } else {
      status.textContent = wakeLock ? 'screen will stay on' : 'bigger text';
    }
  }

  function enable() {
    document.body.classList.add('cooking-mode');
    button.textContent = 'Exit Cooking Mode';
    button.setAttribute('aria-pressed', 'true');
    localStorage.setItem(STORAGE_KEY, '1');
    show(page);
    requestWakeLock().then(setStatus);
    setStatus();
  }

  function disable() {
    document.body.classList.remove('cooking-mode');
    button.textContent = 'Cooking Mode';
    button.setAttribute('aria-pressed', 'false');
    status.textContent = '';
    localStorage.setItem(STORAGE_KEY, '0');
    if (wakeLock) wakeLock.release();
    scrollTo(0, 0);
  }

  button.addEventListener('click', () => {
    document.body.classList.contains('cooking-mode') ? disable() : enable();
  });

  // wake locks are released automatically when the tab is hidden; re-acquire on return
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && document.body.classList.contains('cooking-mode') && !wakeLock) {
      requestWakeLock().then(setStatus);
    }
  });

  if (localStorage.getItem(STORAGE_KEY) === '1') enable();
</script>

<script>
  // Step timers: every duration in a step is a button. Tap to start a countdown, tap a
  // running one to cancel, tap a finished one to dismiss. Timers keep an end timestamp
  // rather than counting ticks, so a backgrounded or locked phone (which throttles
  // intervals) still shows the right time on return, and they persist per recipe across
  // reloads.
  import { formatClock } from '../../lib/timers';

  const STORAGE_KEY = `recipes-chrisdlg:timers:${location.pathname}`;
  const list = document.getElementById('steps')!;
  // Cooking Mode shows one step at a time, so every live timer also gets a chip in this
  // tray (CSS hides it outside Cooking Mode); tapping a chip jumps to that timer's step
  const tray = document.getElementById('timer-tray')!;
  const baseTitle = document.title;
  const running = new Map<HTMLButtonElement, number>(); // button -> end time (epoch ms)
  const ringing = new Set<HTMLButtonElement>();
  const chips = new Map<HTMLButtonElement, HTMLButtonElement>();

  // data-timer-id is "<step index>-<part index>"; pages are 1-based steps
  const stepOf = (button: HTMLButtonElement) => Number(button.dataset.timerId!.split('-')[0]) + 1;

  function chip(button: HTMLButtonElement, text: string) {
    let c = chips.get(button);
    if (!c) {
      c = document.createElement('button');
      c.type = 'button';
      c.className = 'tray-timer';
      c.dataset.page = String(stepOf(button));
      tray.appendChild(c);
      chips.set(button, c);
    }
    c.textContent = `Step ${stepOf(button)} · ${text}`;
    return c;
  }

  function dropChip(button: HTMLButtonElement) {
    chips.get(button)?.remove();
    chips.delete(button);
  }

  tray.addEventListener('click', (event) => {
    const c = (event.target as HTMLElement).closest<HTMLButtonElement>('.tray-timer');
    if (c) document.dispatchEvent(new CustomEvent('cook:goto', { detail: Number(c.dataset.page) }));
  });
  let interval: ReturnType<typeof setInterval> | null = null;
  // browsers only allow sound after a user gesture, so this is created on the first start tap
  let audio: AudioContext | null = null;

  function save() {
    const saved: Record<string, number> = {};
    running.forEach((end, button) => (saved[button.dataset.timerId!] = end));
    localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
  }

  function chime() {
    if (!audio) return;
    // three short beeps, twice
    for (let i = 0; i < 6; i++) {
      const at = audio.currentTime + i * 0.35 + (i >= 3 ? 0.8 : 0);
      const osc = audio.createOscillator();
      const gain = audio.createGain();
      osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.25, at);
      gain.gain.exponentialRampToValueAtTime(0.001, at + 0.25);
      osc.connect(gain).connect(audio.destination);
      osc.start(at);
      osc.stop(at + 0.25);
    }
  }

  function reset(button: HTMLButtonElement) {
    running.delete(button);
    ringing.delete(button);
    dropChip(button);
    button.classList.remove('running', 'done');
    button.textContent = button.dataset.label!;
    button.setAttribute('aria-label', `start ${button.dataset.label} timer`);
  }

  function ring(button: HTMLButtonElement) {
    running.delete(button);
    ringing.add(button);
    button.classList.remove('running');
    button.classList.add('done');
    button.textContent = `${button.dataset.label} done`;
    chip(button, `${button.dataset.label} done`).classList.add('done');
    button.setAttribute('aria-label', `${button.dataset.label} timer done, tap to dismiss`);
    navigator.vibrate?.([300, 150, 300, 150, 300]);
    chime();
  }

  function update() {
    const now = Date.now();
    let soonest: number | null = null;
    for (const [button, end] of running) {
      const remaining = (end - now) / 1000;
      if (remaining <= 0) {
        ring(button);
        save();
        continue;
      }
      button.textContent = formatClock(remaining);
      chip(button, formatClock(remaining));
      if (soonest === null || remaining < soonest) soonest = remaining;
    }
    // the tab title carries the countdown, so it's visible from another tab or app switcher
    if (ringing.size) document.title = `⏰ done · ${baseTitle}`;
    else if (soonest !== null) document.title = `⏱ ${formatClock(soonest)} · ${baseTitle}`;
    else document.title = baseTitle;
    if (!running.size && interval !== null) {
      clearInterval(interval);
      interval = null;
    }
  }

  function start(button: HTMLButtonElement, end: number) {
    running.set(button, end);
    button.classList.add('running');
    button.setAttribute('aria-label', `${button.dataset.label} timer running, tap to cancel`);
    if (interval === null) interval = setInterval(update, 250);
  }

  list.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.step-timer');
    if (!button) return;
    if (ringing.has(button)) {
      reset(button);
    } else if (running.has(button)) {
      // a confirm, because a wet-handed mis-tap shouldn't silently lose a 40-minute timer
      if (!confirm(`Cancel the ${button.dataset.label} timer?`)) return;
      reset(button);
    } else {
      if (!audio && typeof AudioContext !== 'undefined') audio = new AudioContext();
      audio?.resume();
      start(button, Date.now() + Number(button.dataset.seconds) * 1000);
    }
    save();
    update();
  });

  // intervals are throttled or paused in a hidden tab; catch up the moment it's visible
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') update();
  });

  let saved: Record<string, number> = {};
  try {
    saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
  } catch {
    // corrupt entry: start clean
  }
  for (const [id, end] of Object.entries(saved)) {
    const button = list.querySelector<HTMLButtonElement>(`.step-timer[data-timer-id="${id}"]`);
    if (button) start(button, end);
  }
  update();
</script>
